# Copy this file to .env.local and fill in your Supabase project's values.
# Find these under Supabase Dashboard -> Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Never put the service_role key here / in any NEXT_PUBLIC_ variable.
# This app never uses it — all access is governed by Row Level Security.
